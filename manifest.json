{
  "manifest_version": 3,
  "name": "ADIA-X Sarcasm Detector",
  "version": "1.0.0",
  "description": "Detects sarcasm in X (Twitter) tweets",
  "permissions": [
    "activeTab",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://twitter.com/*",
    "https://x.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://twitter.com/*",
        "https://x.com/*"
      ],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "web_accessible_resources": [
    {
      "resources": ["model.js", "*.js"],
      "matches": ["https://twitter.com/*", "https://x.com/*"]
    }
  ]
}

