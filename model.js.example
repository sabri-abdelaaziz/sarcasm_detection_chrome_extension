/**
 * Example JavaScript Model for Sarcasm Detection
 * 
 * This is a template file. Copy this to model.js and implement your actual model.
 * 
 * Your model function should:
 * 1. Accept a string (tweet text) as input
 * 2. Return an object with:
 *    - isSarcasm: boolean
 *    - confidence: number (0.0 to 1.0)
 * 
 * You can use:
 * - TensorFlow.js for ML models
 * - ONNX Runtime for ONNX models
 * - Any other JavaScript ML library
 * - Or your own custom logic
 */

// Example 1: Simple keyword-based model
window.detectSarcasmModel = function(text) {
    const sarcasmKeywords = [
        'sure', 'obviously', 'totally', 'definitely', 'yeah right',
        'as if', 'whatever', 'great', 'wonderful', 'perfect',
        'love it', 'amazing', 'brilliant', 'genius', 'fantastic'
    ];
    
    const lowerText = text.toLowerCase();
    const keywordCount = sarcasmKeywords.filter(kw => lowerText.includes(kw)).length;
    const hasExclamation = (text.match(/!/g) || []).length > 1;
    const hasQuestion = text.includes('?');
    
    // Simple scoring
    let score = 0;
    if (keywordCount > 0) score += 0.3;
    if (keywordCount > 1) score += 0.2;
    if (hasExclamation) score += 0.2;
    if (hasQuestion && keywordCount > 0) score += 0.1;
    
    const isSarcasm = score > 0.4;
    const confidence = Math.min(score + 0.3, 0.95);
    
    return {
        isSarcasm: isSarcasm,
        confidence: confidence
    };
};

